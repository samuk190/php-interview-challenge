{
    "openapi": "3.0.0",
    "info": {
        "title": "Animal Facts API",
        "description": "REST API built with Laravel 9 / PHP 8.1 that serves curated facts about animals (Cat Facts & Dog Facts).",
        "contact": {
            "name": "API Support",
            "email": "support@example.com"
        },
        "license": {
            "name": "MIT",
            "url": "https://opensource.org/licenses/MIT"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8042",
            "description": "Animal Facts API Server"
        }
    ],
    "paths": {
        "/api/v1/cat-facts/{id}": {
            "get": {
                "tags": [
                    "Cat Facts"
                ],
                "summary": "Get a single cat fact",
                "description": "Retrieves a cat fact by its integer ID.",
                "operationId": "getCatFactById",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Cat fact ID",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Cat fact found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CatFact"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Cat fact not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            },
            "put": {
                "tags": [
                    "Cat Facts"
                ],
                "summary": "Update a cat fact",
                "description": "Updates an existing cat fact by its ID.",
                "operationId": "updateCatFact",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Cat fact ID",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "description": "Updated cat fact payload",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/FactInput"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Successfully updated cat fact",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CatFact"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Cat fact not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationErrorResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            },
            "delete": {
                "tags": [
                    "Cat Facts"
                ],
                "summary": "Delete a cat fact",
                "description": "Deletes a cat fact by its ID.",
                "operationId": "deleteCatFact",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Cat fact ID",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Cat fact successfully deleted"
                    },
                    "404": {
                        "description": "Cat fact not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/cat-facts": {
            "get": {
                "tags": [
                    "Cat Facts"
                ],
                "summary": "List cat facts (paginated)",
                "description": "Returns a paginated list of cat facts with configurable page size.",
                "operationId": "getCatFactsList",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page number to retrieve (integer >= 1)",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 1,
                            "minimum": 1
                        }
                    },
                    {
                        "name": "pageSize",
                        "in": "query",
                        "description": "Number of facts per page (integer >= 1 and <= 100, default 25)",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 25,
                            "maximum": 100,
                            "minimum": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Paginated list of cat facts",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PaginatedCatFacts"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation failure (e.g. invalid page or pageSize)",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationErrorResponse"
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Cat Facts"
                ],
                "summary": "Create a cat fact",
                "description": "Stores a new cat fact in the database.",
                "operationId": "storeCatFact",
                "requestBody": {
                    "description": "Cat fact payload",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/FactInput"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Successfully created cat fact",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CatFact"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error (missing or invalid fact)",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationErrorResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
