        "/api/v1": {
            "get": {
                "tags": [
                    "Discovery"
                ],
                "summary": "API Root Discovery",
                "description": "Returns API service name, version, and exposed resource URLs.",
                "operationId": "getApiDiscovery",
                "responses": {
                    "200": {
                        "description": "Successful discovery response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "name": {
                                            "type": "string",
                                            "example": "Jobsity PHP Human Interview challenge API"
                                        },
                                        "version": {
                                            "type": "integer",
                                            "example": 1
                                        },
                                        "resources": {
                                            "properties": {
                                                "cat-facts": {
                                                    "type": "string",
                                                    "example": "http://localhost:8042/api/v1/cat-facts"
                                                },
                                                "dog-facts": {
                                                    "type": "string",
                                                    "example": "http://localhost:8042/api/v1/dog-facts"
                                                },
                                                "documentation": {
                                                    "type": "string",
                                                    "example": "http://localhost:8042/api/documentation"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "FactInput": {
                "required": [
                    "fact"
                ],
                "properties": {
                    "fact": {
                        "description": "The animal fact text",
                        "type": "string",
                        "maxLength": 255,
                        "example": "A group of cats is called a clowder."
                    }
                },
                "type": "object"
            },
            "CatFact": {
                "required": [
                    "id",
                    "fact",
                    "created_at",
                    "updated_at"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "fact": {
                        "type": "string",
                        "example": "A group of cats is called a clowder."
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2026-11-10T05:18:42.000000Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2026-11-10T05:18:42.000000Z"
                    }
                },
                "type": "object"
            },
            "DogFact": {
                "required": [
                    "id",
                    "fact",
                    "created_at",
                    "updated_at"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "fact": {
                        "type": "string",
                        "example": "Dogs have a sense of time and predict future events."
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2026-11-10T05:18:42.000000Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2026-11-10T05:18:42.000000Z"
                    }
                },
                "type": "object"
            },
            "PaginationLink": {
                "properties": {
                    "url": {
                        "type": "string",
                        "example": "http://localhost:8042/api/v1/cat-facts?page=1",
                        "nullable": true
                    },
                    "label": {
                        "type": "string",
                        "example": "1"
                    },
                    "active": {
                        "type": "boolean",
                        "example": true
                    }
                },
                "type": "object"
            },
            "PaginatedCatFacts": {
                "properties": {
                    "current_page": {
                        "type": "integer",
                        "example": 1
                    },
                    "data": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/CatFact"
                        }
                    },
                    "first_page_url": {
                        "type": "string",
                        "example": "http://localhost:8042/api/v1/cat-facts?page=1"
                    },
                    "from": {
                        "type": "integer",
                        "example": 1,
                        "nullable": true
                    },
                    "last_page": {
                        "type": "integer",
                        "example": 5
                    },
                    "last_page_url": {
                        "type": "string",
                        "example": "http://localhost:8042/api/v1/cat-facts?page=5"
                    },
                    "links": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/PaginationLink"
                        }
                    },
                    "next_page_url": {
                        "type": "string",
                        "example": "http://localhost:8042/api/v1/cat-facts?page=2",
                        "nullable": true
                    },
                    "path": {
                        "type": "string",
                        "example": "http://localhost:8042/api/v1/cat-facts"
                    },
                    "per_page": {
                        "type": "integer",
                        "example": 25
                    },
                    "prev_page_url": {
                        "type": "string",
                        "example": null,
                        "nullable": true
                    },
                    "to": {
                        "type": "integer",
                        "example": 25,
                        "nullable": true
                    },
                    "total": {
                        "type": "integer",
                        "example": 120
                    }
                },
                "type": "object"
            },
            "PaginatedDogFacts": {
                "properties": {
                    "current_page": {
                        "type": "integer",
                        "example": 1
                    },
                    "data": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/DogFact"
                        }
                    },
                    "first_page_url": {
                        "type": "string",
                        "example": "http://localhost:8042/api/v1/dog-facts?page=1"
                    },
                    "from": {
                        "type": "integer",
                        "example": 1,
                        "nullable": true
                    },
                    "last_page": {
                        "type": "integer",
                        "example": 5
                    },
                    "last_page_url": {
                        "type": "string",
                        "example": "http://localhost:8042/api/v1/dog-facts?page=5"
                    },
                    "links": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/PaginationLink"
                        }
                    },
                    "next_page_url": {
                        "type": "string",
                        "example": "http://localhost:8042/api/v1/dog-facts?page=2",
                        "nullable": true
                    },
                    "path": {
                        "type": "string",
                        "example": "http://localhost:8042/api/v1/dog-facts"
                    },
                    "per_page": {
                        "type": "integer",
                        "example": 25
                    },
                    "prev_page_url": {
                        "type": "string",
                        "example": null,
                        "nullable": true
                    },
                    "to": {
                        "type": "integer",
                        "example": 25,
                        "nullable": true
                    },
                    "total": {
                        "type": "integer",
                        "example": 120
                    }
                },
                "type": "object"
            },
            "ErrorResponse": {
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "Resource not found"
                    }
                },
                "type": "object"
            },
            "ValidationErrorResponse": {
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "The fact field is required."
                    },
                    "errors": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "type": "object"
            }
        }
    },
    "tags": [
        {
            "name": "Discovery",
            "description": "API root discovery and status"
        },
        {
            "name": "Cat Facts",
            "description": "Operations on Cat Facts"
        },
        {
            "name": "Dog Facts",
            "description": "Operations on Dog Facts"
        }
    ]
}