                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/dog-facts": {
            "get": {
                "tags": [
                    "Dog Facts"
                ],
                "summary": "List dog facts (paginated)",
                "description": "Returns a paginated list of dog facts with configurable page size.",
                "operationId": "getDogFactsList",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page number to retrieve (integer >= 1)",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 1,
                            "minimum": 1
                        }
                    },
                    {
                        "name": "pageSize",
                        "in": "query",
                        "description": "Number of facts per page (integer >= 1 and <= 100, default 25)",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 25,
                            "maximum": 100,
                            "minimum": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Paginated list of dog facts",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PaginatedDogFacts"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation failure (e.g. invalid page or pageSize)",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationErrorResponse"
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Dog Facts"
                ],
                "summary": "Create a dog fact",
                "description": "Stores a new dog fact in the database.",
                "operationId": "storeDogFact",
                "requestBody": {
                    "description": "Dog fact payload",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/FactInput"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Successfully created dog fact",
                        "content": {
                            "application/json": {
                                "schema": {
