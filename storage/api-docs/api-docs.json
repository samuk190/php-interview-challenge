                },
                "responses": {
                    "200": {
                        "description": "Successfully updated dog fact",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/DogFact"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Dog fact not found",
                        "content": {
                            "application/json": {
